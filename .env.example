# ---------------------------------------------------------------------------
# EduBridge environment configuration
# Copy this file to `.env.local` and fill in real values. Never commit secrets.
# ---------------------------------------------------------------------------

# Public application URL (no trailing slash). Used to build email links and to
# verify the Origin header on state-changing requests.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# OpenTelemetry collector endpoint. Required in production for request/error
# telemetry; set any collector authorization headers only in a secret manager.
OTEL_EXPORTER_OTLP_ENDPOINT=""
OTEL_EXPORTER_OTLP_HEADERS=""

# ---------------------------------------------------------------------------
# Database (Milestone 2)
#
# Production: a managed PostgreSQL 16+ instance.
# Local development: run `npm run db:start` first, then use the URL below.
# The PGlite development server keeps prepared statements across client
# reconnects, so this local URL includes `&pgbouncer=true` to make Prisma use
# simple queries. Remove that parameter for a managed PostgreSQL instance.
#
# Production shape (store the real value in the secret manager, not here):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/edubridge?schema=public&sslmode=verify-full&connect_timeout=10&pool_timeout=10&connection_limit=10"
# Production readiness requires TLS, finite timeouts, and a bounded pool.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/postgres?schema=public&pgbouncer=true"

# Managed staging verification (see docs/STAGING-DATABASE-VERIFICATION.md).
# Inject these from the provider secret store, never from a committed file.
# STAGING_DATABASE_URL="pooled app endpoint copied from the provider"
# STAGING_DATABASE_URL_DIRECT="direct endpoint copied from the provider"
# STAGING_CONFIRM=STAGING
# STAGING_CONFIRM_MIGRATE=MIGRATE
# STAGING_CONFIRM_TESTS=TESTS
# STAGING_POOLED_HOST_MARKER=-pooler
# STAGING_FORBIDDEN_IDENTITY="postgresql://host:port/database"
# STAGING_INTEGRATION_DATABASE_URL="separate disposable staging database"
# STAGING_SHADOW_DATABASE_URL="separate disposable shadow database"

# Authentication secret: 32+ random bytes, base64. Used to pepper hashed rate
# limit keys and to sign short-lived values. Rotating it signs users out.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Separate 32+ character key that encrypts TOTP seeds at rest (AES-256-GCM).
# Required in production. Store it in the secret manager and NEVER rotate or
# lose it without a migration plan: enrolled accounts cannot decrypt their
# seeds with a different key. Rotating AUTH_SECRET does not affect MFA seeds.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MFA_ENCRYPTION_KEY=""

# Breached-password checking uses the HIBP k-anonymity range API. Production
# always enforces it and fails closed if the provider is unreachable. Set true
# only to exercise the same check in local development or preview.
HIBP_ENABLED="false"

# Email-verification enforcement rollout. Set this ONCE when enforcement goes
# live and do not change it on redeploys. Accounts created before this instant
# get a fixed 30-day grace window ending at this timestamp + 30 days; accounts
# created on or after it must verify before using the workspace. Required in
# production. ISO 8601 with an explicit timezone.
EMAIL_VERIFICATION_ENFORCEMENT_START="2026-01-01T00:00:00.000Z"

# Optional bootstrap administrators. Comma-separated account email addresses.
# A listed account is promoted to SUPER_ADMIN only after its email is verified
# and it signs in successfully; the grant is audited. Leave empty unless this is
# the intended break-glass setup. Role changes are normally made in /admin/access.
BOOTSTRAP_ADMIN_EMAILS=""

# Google OAuth sign-in. Register this exact redirect URI in Google Cloud:
# http://localhost:3000/api/auth/google/callback (use the HTTPS app URL in
# production). Setup guide: docs/GOOGLE-OAUTH.md. Keep the secret server-side.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# Email delivery (Milestone 2)
#
# console  -> write messages to .data/mail/ (development only)
# smtp     -> deliver through the SMTP settings below (required in production)
# ---------------------------------------------------------------------------
EMAIL_TRANSPORT="console"
# Production requires a deliverable sender; the .example address below is a
# local-development placeholder and fails production readiness.
EMAIL_FROM="EduBridge <no-reply@edubridge.example>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE="false"

# Published, deliverable contacts for security reports and privacy requests.
# Placeholder/reserved domains are rejected by production readiness.
SECURITY_CONTACT_EMAIL=""
PRIVACY_CONTACT_EMAIL=""

# ---------------------------------------------------------------------------
# AI advisor — provider is configurable.
# Supported: openai | anthropic | openrouter | compatible
# ---------------------------------------------------------------------------
AI_PROVIDER="openai"
AI_API_KEY=""
AI_MODEL="gpt-4.1-mini"
# Optional base URL for OpenAI-compatible endpoints (required for `compatible`)
AI_BASE_URL=""

# Safety and cost controls. All are optional; these are the production defaults.
AI_TIMEOUT_MS="30000"
AI_MAX_OUTPUT_TOKENS="1200"
AI_MAX_CONTEXT_MESSAGES="16"
AI_MAX_INPUT_CHARS="4000"
AI_MAX_TOOL_ROUNDS="4"
AI_MAX_TOOLS_PER_ROUND="5"
AI_MESSAGES_PER_MINUTE="8"
AI_DAILY_USER_MESSAGES="40"
AI_DAILY_USER_COST_USD="2"
AI_DAILY_GLOBAL_COST_USD="25"
# Override only if your provider/model pricing differs from the built-in table.
AI_PRICE_INPUT_PER_MILLION=""
AI_PRICE_OUTPUT_PER_MILLION=""

# ---------------------------------------------------------------------------
# Private S3-compatible document storage
# Both buckets must have public access blocked; see docs/SECURITY.md.
# STORAGE_ENDPOINT is optional (for S3-compatible providers); use HTTPS except
# for localhost development. Leave credentials empty to use the provider chain.
#
# Local development without S3/ClamAV: uncomment the three DRIVER settings in
# your git-ignored .env.local. Both local drivers are refused when NODE_ENV is
# production, so a deployment can never silently downgrade to disk storage or
# an unauthenticated scanner. Production must keep the S3/clamd settings below.
# ---------------------------------------------------------------------------
# STORAGE_DRIVER="local"
# STORAGE_LOCAL_DIR=".data/storage"
# MALWARE_SCANNER_DRIVER="local"

STORAGE_ENDPOINT=""
STORAGE_REGION="us-east-1"
STORAGE_BUCKET="edubridge-private-documents"
STORAGE_BACKUP_BUCKET="edubridge-private-backups"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_SESSION_TOKEN=""
STORAGE_SERVER_SIDE_ENCRYPTION="AES256"
STORAGE_KMS_KEY_ID=""

# Malware scanning (ClamAV clamd INSTREAM protocol). Uploads fail closed when
# the scanner is unavailable. Keep clamd on a private network.
MALWARE_SCANNER_HOST="127.0.0.1"
MALWARE_SCANNER_PORT="3310"

# Restore only to a separate, verified recovery target. `db:restore` also
# requires BACKUP_ID, RESTORE_CONFIRM=RESTORE, and RESTORE_TARGET_NAME matching
# the recovery database name exactly. The destination bucket must be empty.
RESTORE_DATABASE_URL=""
RESTORE_DOCUMENT_BUCKET=""
RESTORE_TARGET_NAME=""
