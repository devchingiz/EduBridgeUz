{
  "name": "edubridge",
  "version": "0.1.0",
  "private": true,
  "description": "EduBridge — international university discovery, scholarship search, and application management.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:all": "npm run test && npm run test:integration",
    "db:start": "node scripts/dev-db.mjs",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --env-file=.env scripts/seed-catalog.mts",
    "db:import:qs": "node --env-file=.env scripts/import-qs-universities.mts",
    "db:verify:qs": "node --env-file=.env scripts/verify-qs-import.mts",
    "db:studio": "prisma studio",
    "catalog:expire": "node --env-file=.env scripts/expire-catalog.mts",
    "db:backup": "node --env-file=.env scripts/backup.mjs",
    "db:restore": "node --env-file=.env scripts/restore.mjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@node-rs/argon2": "2.2.2",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-accordion": "1.3.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-slot": "1.5.0",
    "@smithy/node-http-handler": "4.14.2",
    "@vercel/otel": "2.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "framer-motion": "14.13.0",
    "geist": "1.9.2",
    "lucide-react": "1.72.0",
    "next": "16.4.6",
    "next-themes": "0.4.6",
    "nodemailer": "10.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "3.10.1",
    "remark-gfm": "^4.0.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@electric-sql/pglite-socket": "0.2.19",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.13.6",
    "@types/nodemailer": "7.0.11",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  }
}
